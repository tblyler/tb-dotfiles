#!/usr/bin/zsh
if command -v herdr &> /dev/null; then
	alias h='herdr'

	# completions are (re)generated by herdr's mise `postinstall` (see
	# mise.toml) whenever a new version installs; this only covers a machine
	# whose current herdr was installed before that hook existed
	if ! [ -r "${ZSH_COMPLETIONS_DIR}/_herdr" ]; then
		herdr completion zsh > "${ZSH_COMPLETIONS_DIR}/_herdr"
	fi
fi
